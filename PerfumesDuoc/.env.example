# Copia este archivo a ".env" (misma carpeta que docker-compose.yml).

# --- Autenticación ---------------------------------------------------------
# local = login simulado (desarrollo) | azure = Microsoft Entra ID real
JWT_MODE=local
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# --- Frontend --------------------------------------------------------------
# URL del API Gateway que usa el navegador (Kong local o AWS API Gateway)
VITE_API_GATEWAY_URL=http://localhost:8080
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# --- mspago ----------------------------------------------------------------
# URL del frontend a la que Webpay devuelve al cliente
WEBPAY_RETURN_URL=http://localhost:5173/callback
FRAUDE_MAX_INTENTOS=3
FRAUDE_VENTANA_SEGUNDOS=10
FRAUDE_BLOQUEO_MINUTOS=30
